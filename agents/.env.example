# OpenRouter API key (required) - https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Model defaults (any OpenRouter-hosted model id)
# Fast: cheap/quick, used for Concierge and Tour Guide turn-by-turn chat.
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
# Smart: stronger reasoning, used for Patent multi-agent and Clause structured output.
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4.5

# Optional headers OpenRouter uses for attribution (recommended).
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Hamza & Co. Oracles

# Go backend URL (used for tool calls and RAG ingestion).
BACKEND_URL=http://localhost:8080

# CORS allowed origins (comma-separated). Leave * for permissive local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Service port.
PORT=8001

# Per-IP rate limit (messages/minute).
RATE_LIMIT_PER_MINUTE=20

# Session TTL in seconds (1 hour).
SESSION_TTL_SECONDS=3600

# Embedding model used for the Concierge RAG index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
